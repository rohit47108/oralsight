{
  "name": "stoma3d",
  "version": "0.1.0",
  "private": true,
  "description": "Stoma3D non-diagnostic oral observation research prototype",
  "packageManager": "pnpm@11.9.0",
  "engines": {
    "node": ">=22 <25"
  },
  "scripts": {
    "dev:mobile": "pnpm --filter @stoma3d/mobile start",
    "android:doctor:windows": "node scripts/windows-android.mjs doctor",
    "android:setup:windows": "node scripts/windows-android.mjs setup",
    "android:prebuild:windows": "node scripts/windows-android.mjs prebuild",
    "android:build:windows": "node scripts/windows-android.mjs build",
    "android:install:windows": "node scripts/windows-android.mjs install",
    "android:build-release:windows": "node scripts/windows-android.mjs build-release",
    "android:install-release:windows": "node scripts/windows-android.mjs install-release",
    "contracts:generate": "pnpm --filter @stoma3d/contracts generate && prettier --write packages/contracts/generated/stoma3d-contracts.schema.json packages/contracts/generated/stoma3d-platform-contracts.schema.json",
    "test": "node --test scripts/*.test.mjs && pnpm -r --if-present test",
    "typecheck": "pnpm -r --if-present typecheck",
    "format:check": "prettier --check .",
    "format": "prettier --write .",
    "licenses:generate": "uv run --frozen --all-packages --no-sync python scripts/generate_third_party_notices.py",
    "licenses:check": "uv run --frozen --all-packages --no-sync python scripts/generate_third_party_notices.py --check",
    "security:patched-deps": "node scripts/verify-patched-image-size.mjs",
    "audit:dependencies": "pnpm security:patched-deps && pnpm audit --audit-level high --ignore GHSA-w3rx-r6r6-pgpr --ignore GHSA-5p2g-fcmc-qvqq"
  },
  "devDependencies": {
    "prettier": "3.9.6",
    "typescript": "5.9.3",
    "vitest": "4.1.10"
  }
}
