# Auth0 Regular Web Application
AUTH0_DOMAIN=your-tenant.us.auth0.com
AUTH0_CLIENT_ID=replace-me
AUTH0_CLIENT_SECRET=replace-me
# Generate with: openssl rand -hex 32
AUTH0_SECRET=replace-with-64-hex-characters
APP_BASE_URL=http://localhost:3000
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Auth0 API identifier configured for the platform service
AUTH0_AUDIENCE=oralsight-platform-api

# Stateful OralSight platform API. Never expose this as NEXT_PUBLIC_*.
ORALSIGHT_PLATFORM_API_URL=http://127.0.0.1:8001

# CI-only escape hatch for builds that use explicit dummy values. Never set this
# in Vercel or another deployment environment.
# ORALSIGHT_ALLOW_CI_DUMMY_WEB_ENV=true
