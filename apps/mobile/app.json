{
  "expo": {
    "name": "OralSight",
    "slug": "oralsight",
    "version": "0.1.0",
    "icon": "./assets/oralsight-icon.png",
    "orientation": "default",
    "scheme": "oralsight",
    "userInterfaceStyle": "automatic",
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "org.oralsight.prototype",
      "icon": "./assets/oralsight-icon.png",
      "infoPlist": {
        "NSCameraUsageDescription": "OralSight uses the camera only when you choose to create a structured mouth observation.",
        "ITSAppUsesNonExemptEncryption": false
      }
    },
    "android": {
      "package": "org.oralsight.prototype",
      "allowBackup": false,
      "adaptiveIcon": {
        "foregroundImage": "./assets/oralsight-adaptive-foreground.png",
        "backgroundColor": "#F5FAF9"
      },
      "permissions": ["CAMERA", "VIBRATE"],
      "blockedPermissions": ["android.permission.RECORD_AUDIO"]
    },
    "plugins": [
      "expo-router",
      [
        "expo-camera",
        {
          "cameraPermission": "Allow OralSight to capture a mouth observation you choose to record.",
          "recordAudioAndroid": false
        }
      ],
      [
        "expo-image-picker",
        {
          "photosPermission": "Allow OralSight to select a mouth image you choose to analyze.",
          "cameraPermission": "Allow OralSight to capture a mouth observation you choose to record."
        }
      ],
      [
        "expo-secure-store",
        {
          "configureAndroidBackup": true,
          "faceIDPermission": "Allow OralSight to protect your local observations."
        }
      ],
      [
        "expo-sqlite",
        {
          "useSQLCipher": true,
          "enableFTS": false,
          "android": {
            "enableFTS": false
          },
          "ios": {
            "customBuildFlags": ["-DSQLITE_HAS_CODEC"]
          }
        }
      ],
      "expo-font",
      "expo-background-task",
      [
        "expo-notifications",
        {
          "color": "#0B7A75",
          "defaultChannel": "oralsight-follow-up"
        }
      ],
      "expo-sharing",
      [
        "expo-splash-screen",
        {
          "backgroundColor": "#F5FAF9",
          "image": "./assets/oralsight-adaptive-foreground.png",
          "imageWidth": 180,
          "resizeMode": "contain",
          "dark": {
            "backgroundColor": "#071A21",
            "image": "./assets/oralsight-adaptive-foreground.png"
          }
        }
      ]
    ],
    "experiments": {
      "typedRoutes": true
    },
    "extra": {
      "router": {
        "origin": false
      }
    }
  }
}
