{
  "name": "@oralsight/mobile",
  "version": "0.1.0",
  "private": true,
  "main": "expo-router/entry",
  "scripts": {
    "start": "expo start --dev-client",
    "android": "expo run:android",
    "ios": "expo run:ios",
    "doctor": "pnpm dlx expo-doctor@latest",
    "config:public": "expo config --type public",
    "export:android": "expo export --clear --platform android --output-dir .expo/export-android",
    "export:ios": "expo export --clear --platform ios --output-dir .expo/export-ios",
    "eas:configure": "pnpm dlx eas-cli@latest build:configure",
    "eas:build:android:development": "pnpm dlx eas-cli@latest build --platform android --profile development",
    "eas:build:ios:development": "pnpm dlx eas-cli@latest build --platform ios --profile development",
    "eas:build:ios:simulator": "pnpm dlx eas-cli@latest build --platform ios --profile development-simulator",
    "eas:build:android:preview": "pnpm dlx eas-cli@latest build --platform android --profile preview",
    "eas:build:ios:preview": "pnpm dlx eas-cli@latest build --platform ios --profile preview",
    "eas:build:android:production": "pnpm dlx eas-cli@latest build --platform android --profile production",
    "eas:build:ios:production": "pnpm dlx eas-cli@latest build --platform ios --profile production",
    "typecheck": "tsc --noEmit",
    "test": "vitest run"
  },
  "dependencies": {
    "@expo/metro-runtime": "57.0.7",
    "@expo/vector-icons": "^15.1.1",
    "@infinitered/react-native-mlkit-face-detection": "5.0.0",
    "@noble/ciphers": "^2.1.1",
    "@noble/curves": "^2.0.1",
    "@noble/hashes": "^2.0.1",
    "@oralsight/contracts": "workspace:*",
    "@react-three/fiber": "^9.4.0",
    "@shopify/react-native-skia": "2.6.2",
    "base64-js": "^1.5.1",
    "expo": "^57.0.8",
    "expo-camera": "^57.0.0",
    "expo-constants": "~57.0.7",
    "expo-crypto": "^57.0.0",
    "expo-dev-client": "~57.0.9",
    "expo-file-system": "^57.0.0",
    "expo-font": "~57.0.1",
    "expo-gl": "^57.0.0",
    "expo-haptics": "^57.0.0",
    "expo-image-manipulator": "^57.0.6",
    "expo-image-picker": "~57.0.6",
    "expo-linking": "~57.0.4",
    "expo-network": "~57.0.1",
    "expo-print": "^57.0.0",
    "expo-router": "^57.0.8",
    "expo-secure-store": "^57.0.0",
    "expo-sensors": "^57.0.0",
    "expo-sharing": "^57.0.7",
    "expo-speech": "^57.0.0",
    "expo-splash-screen": "~57.0.5",
    "expo-sqlite": "^57.0.0",
    "expo-status-bar": "^57.0.0",
    "expo-system-ui": "~57.0.1",
    "react": "19.2.3",
    "react-dom": "19.2.3",
    "react-native": "0.86.0",
    "react-native-reanimated": "4.5.0",
    "react-native-safe-area-context": "~5.7.0",
    "react-native-screens": "4.26.2",
    "react-native-worklets": "0.10.0",
    "three": "^0.181.1",
    "zod": "4.4.3",
    "zustand": "^5.0.8"
  },
  "devDependencies": {
    "@types/react": "^19.2.2",
    "@types/three": "^0.181.0",
    "babel-preset-expo": "57.0.4",
    "typescript": "~6.0.3",
    "vitest": "4.1.10"
  }
}
