# Loopback is allowed only for local development. Use HTTPS for any non-loopback host.
EXPO_PUBLIC_INFERENCE_URL=http://127.0.0.1:8000

# Standard base64 for the raw 32-byte Ed25519 public key. Required outside loopback.
# This client-side pin is public. Never put the matching private key in EXPO_PUBLIC_*.
EXPO_PUBLIC_RESPONSE_SIGNING_PUBLIC_KEY_B64=

# Optional account and clinician-sharing services. The app remains fully local
# when these values are omitted. Use your public native OIDC client; never add a
# client secret to an Expo variable.
EXPO_PUBLIC_PLATFORM_URL=http://127.0.0.1:8001
# Use a real OIDC tenant; the platform API is not an identity provider.
EXPO_PUBLIC_OIDC_ISSUER=https://your-tenant.us.auth0.com
EXPO_PUBLIC_OIDC_CLIENT_ID=oralsight-mobile
EXPO_PUBLIC_OIDC_AUDIENCE=oralsight-platform-api
EXPO_PUBLIC_WEB_URL=http://127.0.0.1:3000
EXPO_PUBLIC_SHARE_VIEWER_URL=http://127.0.0.1:3000/shared
