# Loopback is allowed only for local development. Use HTTPS for any non-loopback host.
EXPO_PUBLIC_INFERENCE_URL=http://127.0.0.1:8000

# Standard base64 for the raw 32-byte Ed25519 public key. Required outside loopback.
# This client-side pin is public. Never put the matching private key in EXPO_PUBLIC_*.
EXPO_PUBLIC_RESPONSE_SIGNING_PUBLIC_KEY_B64=
