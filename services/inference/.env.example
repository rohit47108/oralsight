# Development is the default when omitted. Production requires response signing
# to be explicitly required and a valid private key to be present at startup.
ORALSIGHT_DEPLOYMENT_MODE=production

# Standard base64 for a protected raw 32-byte Ed25519 private key.
ORALSIGHT_RESPONSE_SIGNING_PRIVATE_KEY_B64=

# Production must fail startup rather than serve unsigned JSON.
ORALSIGHT_REQUIRE_RESPONSE_SIGNING=true

# Optional. If set, it must equal the first 16 lowercase hex characters of the
# SHA-256 digest of the corresponding raw public key.
ORALSIGHT_RESPONSE_SIGNING_KEY_ID=

# Bundled synthetic fixture responses are disabled by default. Enable only for a
# clearly separated demonstration service, never on the normal user endpoint.
ORALSIGHT_ENABLE_DEMO_FIXTURES=false

# Absolute path to a read-only release manifest. Artifact paths inside the
# manifest are relative to the manifest directory. In a container, mount the
# manifest directory and ONNX/evidence files read-only. Leave blank to fail closed.
ORALSIGHT_RELEASE_MANIFEST_PATH=

# Process-local concurrency limit (1-32). Omit to use the safe CPU-based default.
ORALSIGHT_MAX_CONCURRENT_INFERENCE=2
