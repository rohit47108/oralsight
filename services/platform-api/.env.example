# PostgreSQL is required outside automated tests.
STOMA3D_PLATFORM_DATABASE_URL=postgresql+asyncpg://stoma3d:change-me@127.0.0.1:5432/stoma3d
STOMA3D_PLATFORM_ENVIRONMENT=development
STOMA3D_PLATFORM_CREATE_SCHEMA_ON_START=false

# local_test is accepted only in development or test. Use oidc in staging/production.
STOMA3D_PLATFORM_AUTH_MODE=local_test
STOMA3D_PLATFORM_OIDC_AUDIENCE=stoma3d-platform-api
# The API reads only this exact access-token claim. There is no generic roles fallback.
STOMA3D_PLATFORM_OIDC_ROLE_CLAIM=https://stoma3d.app/roles
# Keep provider token refresh within this 60-to-3600-second limit.
STOMA3D_PLATFORM_PRIVILEGED_TOKEN_MAX_AGE_SECONDS=900
STOMA3D_PLATFORM_LOCAL_TEST_ISSUER_URL=https://stoma3d.local.test
STOMA3D_PLATFORM_LOCAL_TEST_SIGNING_SECRET=local-development-only-replace-this-secret
STOMA3D_PLATFORM_SHARE_SECRET_DERIVATION_KEY=replace-with-an-independent-random-secret-at-least-32-characters
STOMA3D_PLATFORM_WORKER_SERVICE_HMAC_SECRET=replace-with-the-same-random-secret-used-by-the-worker
STOMA3D_PLATFORM_OBJECT_STORAGE_BACKEND=local
STOMA3D_PLATFORM_OBJECT_STORAGE_ROOT=.data/object-storage
STOMA3D_PLATFORM_OBJECT_STORAGE_PUBLIC_BASE_URL=http://127.0.0.1:8001
STOMA3D_PLATFORM_OBJECT_STORAGE_BUCKET=stoma3d-private
STOMA3D_PLATFORM_OBJECT_STORAGE_REGION=us-east-1
STOMA3D_PLATFORM_OBJECT_STORAGE_SSE=AES256
STOMA3D_PLATFORM_GENERATED_ASSET_MAX_BYTES=32000000
STOMA3D_PLATFORM_GENERATED_ASSET_RETENTION_DAYS=365
STOMA3D_PLATFORM_EXPORT_RETENTION_DAYS=7
STOMA3D_PLATFORM_PENDING_UPLOAD_LIFETIME_SECONDS=3600
# Must be at least the object-store/ingress maximum accepted PUT duration.
STOMA3D_PLATFORM_UPLOAD_COMPLETION_QUIET_SECONDS=120
STOMA3D_PLATFORM_QUEUE_BACKEND=redis
STOMA3D_PLATFORM_REDIS_URL=redis://127.0.0.1:6379/0
STOMA3D_PLATFORM_QUEUE_DISPATCH_INTERVAL_SECONDS=15
STOMA3D_PLATFORM_QUEUE_REDELIVERY_AFTER_SECONDS=300
STOMA3D_PLATFORM_RETENTION_SWEEP_INTERVAL_SECONDS=900

# Required when AUTH_MODE=oidc.
# STOMA3D_PLATFORM_OIDC_ISSUER_URL=https://example.us.auth0.com/
# STOMA3D_PLATFORM_OIDC_JWKS_URL=https://example.us.auth0.com/.well-known/jwks.json
# Configure the identity provider to emit OIDC_ROLE_CLAIM in API access tokens.
# Never save bootstrap/add-admin/recovery identity values or confirmation phrases here.
# Supply them only to the one operator command process. Additional-admin setup uses
# ADMIN_REFERENCE_SUBJECT, which is an active-account check, not proof of approval.

# Staging/production require s3, rediss://, HTTPS public/OIDC URLs, and oidc auth.
# Prefer workload identity. If static S3 credentials are unavoidable, inject the
# OBJECT_STORAGE_ACCESS_KEY_ID / OBJECT_STORAGE_SECRET_ACCESS_KEY settings from a
# secret manager and never commit them.
