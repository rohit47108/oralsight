# PostgreSQL is required outside automated tests.
ORALSIGHT_PLATFORM_DATABASE_URL=postgresql+asyncpg://oralsight:change-me@127.0.0.1:5432/oralsight
ORALSIGHT_PLATFORM_ENVIRONMENT=development
ORALSIGHT_PLATFORM_CREATE_SCHEMA_ON_START=false

# local_test is accepted only in development or test. Use oidc in staging/production.
ORALSIGHT_PLATFORM_AUTH_MODE=local_test
ORALSIGHT_PLATFORM_OIDC_AUDIENCE=oralsight-platform-api
# The API reads only this exact access-token claim. There is no generic roles fallback.
ORALSIGHT_PLATFORM_OIDC_ROLE_CLAIM=https://oralsight.app/roles
# Keep provider token refresh within this 60-to-3600-second limit.
ORALSIGHT_PLATFORM_PRIVILEGED_TOKEN_MAX_AGE_SECONDS=900
ORALSIGHT_PLATFORM_LOCAL_TEST_ISSUER_URL=https://oralsight.local.test
ORALSIGHT_PLATFORM_LOCAL_TEST_SIGNING_SECRET=local-development-only-replace-this-secret
ORALSIGHT_PLATFORM_SHARE_SECRET_DERIVATION_KEY=replace-with-an-independent-random-secret-at-least-32-characters
ORALSIGHT_PLATFORM_WORKER_SERVICE_HMAC_SECRET=replace-with-the-same-random-secret-used-by-the-worker
ORALSIGHT_PLATFORM_OBJECT_STORAGE_BACKEND=local
ORALSIGHT_PLATFORM_OBJECT_STORAGE_ROOT=.data/object-storage
ORALSIGHT_PLATFORM_OBJECT_STORAGE_PUBLIC_BASE_URL=http://127.0.0.1:8001
ORALSIGHT_PLATFORM_OBJECT_STORAGE_BUCKET=oralsight-private
ORALSIGHT_PLATFORM_OBJECT_STORAGE_REGION=us-east-1
ORALSIGHT_PLATFORM_OBJECT_STORAGE_SSE=AES256
ORALSIGHT_PLATFORM_GENERATED_ASSET_MAX_BYTES=32000000
ORALSIGHT_PLATFORM_GENERATED_ASSET_RETENTION_DAYS=365
ORALSIGHT_PLATFORM_EXPORT_RETENTION_DAYS=7
ORALSIGHT_PLATFORM_PENDING_UPLOAD_LIFETIME_SECONDS=3600
# Must be at least the object-store/ingress maximum accepted PUT duration.
ORALSIGHT_PLATFORM_UPLOAD_COMPLETION_QUIET_SECONDS=120
ORALSIGHT_PLATFORM_QUEUE_BACKEND=redis
ORALSIGHT_PLATFORM_REDIS_URL=redis://127.0.0.1:6379/0
ORALSIGHT_PLATFORM_QUEUE_DISPATCH_INTERVAL_SECONDS=15
ORALSIGHT_PLATFORM_QUEUE_REDELIVERY_AFTER_SECONDS=300
ORALSIGHT_PLATFORM_RETENTION_SWEEP_INTERVAL_SECONDS=900

# Required when AUTH_MODE=oidc.
# ORALSIGHT_PLATFORM_OIDC_ISSUER_URL=https://example.us.auth0.com/
# ORALSIGHT_PLATFORM_OIDC_JWKS_URL=https://example.us.auth0.com/.well-known/jwks.json
# Configure the identity provider to emit OIDC_ROLE_CLAIM in API access tokens.
# Never save bootstrap/add-admin/recovery identity values or confirmation phrases here.
# Supply them only to the one operator command process. Additional-admin setup uses
# ADMIN_REFERENCE_SUBJECT, which is an active-account check, not proof of approval.

# Staging/production require s3, rediss://, HTTPS public/OIDC URLs, and oidc auth.
# Prefer workload identity. If static S3 credentials are unavoidable, inject the
# OBJECT_STORAGE_ACCESS_KEY_ID / OBJECT_STORAGE_SECRET_ACCESS_KEY settings from a
# secret manager and never commit them.
