# Runtime
ORALSIGHT_WORKER_ENVIRONMENT=development
ORALSIGHT_WORKER_CONSUMER_NAME=worker-local-1
ORALSIGHT_WORKER_REDIS_URL=redis://127.0.0.1:6379/0
ORALSIGHT_WORKER_HEALTH_PORT=8010

# Internal services. Production values must use HTTPS.
ORALSIGHT_WORKER_PLATFORM_API_URL=http://127.0.0.1:8001
ORALSIGHT_WORKER_INFERENCE_API_URL=http://127.0.0.1:8000

# Observation surfaces and summary videos render inside this worker. No separate
# reconstruction or video-renderer URL is required.

# Required in production. Use at least 32 random bytes and inject it from a
# secret manager; never commit the real value.
# ORALSIGHT_WORKER_SERVICE_HMAC_SECRET=
ORALSIGHT_WORKER_SERVICE_ID=oralsight-worker

# Queue tuning
ORALSIGHT_WORKER_CONCURRENCY=2
ORALSIGHT_WORKER_READ_BLOCK_MS=2000
ORALSIGHT_WORKER_CLAIM_IDLE_MS=60000
ORALSIGHT_WORKER_HEARTBEAT_INTERVAL_SECONDS=10
ORALSIGHT_WORKER_HEARTBEAT_TTL_SECONDS=35
ORALSIGHT_WORKER_HTTP_TIMEOUT_SECONDS=30
