# Runtime
STOMA3D_WORKER_ENVIRONMENT=development
STOMA3D_WORKER_CONSUMER_NAME=worker-local-1
STOMA3D_WORKER_REDIS_URL=redis://127.0.0.1:6379/0
STOMA3D_WORKER_HEALTH_PORT=8010

# Internal services. Production values must use HTTPS.
STOMA3D_WORKER_PLATFORM_API_URL=http://127.0.0.1:8001
STOMA3D_WORKER_INFERENCE_API_URL=http://127.0.0.1:8000

# Standard base64 for the raw 32-byte Ed25519 public key used by inference.
# Staging, production, and non-loopback development require it. Once configured,
# the worker rejects every unsigned or incorrectly signed analyze/compare response.
# STOMA3D_WORKER_INFERENCE_RESPONSE_SIGNING_PUBLIC_KEY_B64=

# Observation surfaces and summary videos render inside this worker. No separate
# reconstruction or video-renderer URL is required.

# Required in production. Use at least 32 random bytes and inject it from a
# secret manager; never commit the real value.
# STOMA3D_WORKER_SERVICE_HMAC_SECRET=
STOMA3D_WORKER_SERVICE_ID=stoma3d-worker

# Queue tuning
STOMA3D_WORKER_CONCURRENCY=2
STOMA3D_WORKER_READ_BLOCK_MS=2000
STOMA3D_WORKER_CLAIM_IDLE_MS=60000
STOMA3D_WORKER_HEARTBEAT_INTERVAL_SECONDS=10
STOMA3D_WORKER_HEARTBEAT_TTL_SECONDS=35
STOMA3D_WORKER_HTTP_TIMEOUT_SECONDS=30
