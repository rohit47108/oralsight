{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "services": {
    "web": {
      "root": "apps/web",
      "framework": "nextjs"
    },
    "inference": {
      "root": "services/inference",
      "framework": "fastapi",
      "entrypoint": "vercel_entrypoint:app",
      "functions": {
        "**/*.py": {
          "maxDuration": 60
        }
      }
    }
  },
  "rewrites": [
    {
      "source": "/api/v1/:path*",
      "destination": { "service": "inference", "path": "/v1/:path*" }
    },
    {
      "source": "/api/healthz",
      "destination": { "service": "inference", "path": "/healthz" }
    },
    {
      "source": "/(.*)",
      "destination": { "service": "web" }
    }
  ]
}
