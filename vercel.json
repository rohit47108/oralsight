{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "services": {
    "web": {
      "root": "apps/web",
      "framework": "nextjs"
    }
  },
  "rewrites": [
    {
      "source": "/api/v1/:path*",
      "destination": "https://oralsight-inference.vercel.app/api/v1/:path*"
    },
    {
      "source": "/api/healthz",
      "destination": "https://oralsight-inference.vercel.app/api/healthz"
    },
    {
      "source": "/(.*)",
      "destination": { "service": "web" }
    }
  ]
}
