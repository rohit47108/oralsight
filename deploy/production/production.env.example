# Copy to production.env, keep it outside source control, and replace every value.
# Pin images by digest in a real release.
STOMA3D_PLATFORM_IMAGE=registry.example/stoma3d-platform-api@sha256:replace
STOMA3D_INFERENCE_IMAGE=registry.example/stoma3d-inference@sha256:replace
STOMA3D_WORKER_IMAGE=registry.example/stoma3d-worker@sha256:replace
STOMA3D_INGRESS_NETWORK=stoma3d-ingress

# Public TLS endpoints routed by the external ingress proxy.
STOMA3D_PUBLIC_PLATFORM_URL=https://api.example.org
STOMA3D_PUBLIC_INFERENCE_URL=https://inference.example.org

# Managed data services. ssl=require is mandatory for PostgreSQL; Redis uses rediss.
STOMA3D_PLATFORM_DATABASE_URL=postgresql+asyncpg://user:password@db.example.org:5432/stoma3d?ssl=require
STOMA3D_REDIS_URL=rediss://default:password@redis.example.org:6379/0

# OIDC application settings.
STOMA3D_PLATFORM_OIDC_ISSUER_URL=https://identity.example.org/
STOMA3D_PLATFORM_OIDC_JWKS_URL=https://identity.example.org/.well-known/jwks.json
STOMA3D_PLATFORM_OIDC_AUDIENCE=stoma3d-platform-api
# The API reads only this exact access-token claim. There is no generic roles fallback.
STOMA3D_PLATFORM_OIDC_ROLE_CLAIM=https://stoma3d.app/roles
# Keep the provider access-token refresh policy within this 60-to-3600-second limit.
STOMA3D_PLATFORM_PRIVILEGED_TOKEN_MAX_AGE_SECONDS=900
STOMA3D_PLATFORM_PENDING_UPLOAD_LIFETIME_SECONDS=3600
# Must equal or exceed the ingress/object-store maximum accepted PUT duration.
STOMA3D_PLATFORM_UPLOAD_COMPLETION_QUIET_SECONDS=120

# Never store bootstrap/add-admin/recovery subjects or confirmation phrases here.
# Supply them only to the single operator command process described in the runbook.
# Additional-admin setup uses ADMIN_REFERENCE_SUBJECT; it does not record approval.

# Generate independent random secrets. The HMAC value is shared only by platform and worker.
STOMA3D_PLATFORM_SHARE_SECRET_DERIVATION_KEY=replace-with-at-least-32-random-bytes
STOMA3D_WORKER_SERVICE_HMAC_SECRET=replace-with-an-independent-32-byte-random-secret

# Private S3 bucket. Use workload identity; do not put long-lived cloud keys here.
STOMA3D_S3_BUCKET=stoma3d-private-production
STOMA3D_S3_REGION=us-east-1
STOMA3D_S3_SSE=aws:kms
STOMA3D_S3_KMS_KEY_ID=replace-with-kms-key-arn

# Raw 32-byte Ed25519 key pair in standard base64 and its derived key ID.
# The private value belongs only on inference. The public value is pinned by
# worker and mobile clients. The key ID is the first 16 lowercase hex characters
# of SHA-256 over the raw public key.
STOMA3D_RESPONSE_SIGNING_PRIVATE_KEY_B64=replace
STOMA3D_RESPONSE_SIGNING_PUBLIC_KEY_B64=replace
STOMA3D_RESPONSE_SIGNING_KEY_ID=replace

STOMA3D_WORKER_CONSUMER_NAME=worker-production-1
STOMA3D_WORKER_CONCURRENCY=2
STOMA3D_MAX_CONCURRENT_INFERENCE=2
STOMA3D_RATE_LIMIT_PER_CLIENT=30
STOMA3D_RATE_LIMIT_GLOBAL=300
STOMA3D_RATE_LIMIT_WINDOW_SECONDS=60
