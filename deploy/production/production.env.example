# Copy to production.env, keep it outside source control, and replace every value.
# Pin images by digest in a real release.
ORALSIGHT_PLATFORM_IMAGE=registry.example/oralsight-platform-api@sha256:replace
ORALSIGHT_INFERENCE_IMAGE=registry.example/oralsight-inference@sha256:replace
ORALSIGHT_WORKER_IMAGE=registry.example/oralsight-worker@sha256:replace
ORALSIGHT_INGRESS_NETWORK=oralsight-ingress

# Public TLS endpoints routed by the external ingress proxy.
ORALSIGHT_PUBLIC_PLATFORM_URL=https://api.example.org
ORALSIGHT_PUBLIC_INFERENCE_URL=https://inference.example.org

# Managed data services. ssl=require is mandatory for PostgreSQL; Redis uses rediss.
ORALSIGHT_PLATFORM_DATABASE_URL=postgresql+asyncpg://user:password@db.example.org:5432/oralsight?ssl=require
ORALSIGHT_REDIS_URL=rediss://default:password@redis.example.org:6379/0

# OIDC application settings.
ORALSIGHT_PLATFORM_OIDC_ISSUER_URL=https://identity.example.org/
ORALSIGHT_PLATFORM_OIDC_JWKS_URL=https://identity.example.org/.well-known/jwks.json
ORALSIGHT_PLATFORM_OIDC_AUDIENCE=oralsight-platform-api
ORALSIGHT_PLATFORM_OIDC_ROLE_CLAIM=https://oralsight.app/roles
ORALSIGHT_PLATFORM_PENDING_UPLOAD_LIFETIME_SECONDS=3600

# Generate independent random secrets. The HMAC value is shared only by platform and worker.
ORALSIGHT_PLATFORM_SHARE_SECRET_DERIVATION_KEY=replace-with-at-least-32-random-bytes
ORALSIGHT_WORKER_SERVICE_HMAC_SECRET=replace-with-an-independent-32-byte-random-secret

# Private S3 bucket. Use workload identity; do not put long-lived cloud keys here.
ORALSIGHT_S3_BUCKET=oralsight-private-production
ORALSIGHT_S3_REGION=us-east-1
ORALSIGHT_S3_SSE=aws:kms
ORALSIGHT_S3_KMS_KEY_ID=replace-with-kms-key-arn

# Raw 32-byte Ed25519 key in standard base64 and its required key ID.
ORALSIGHT_RESPONSE_SIGNING_PRIVATE_KEY_B64=replace
ORALSIGHT_RESPONSE_SIGNING_KEY_ID=replace

ORALSIGHT_WORKER_CONSUMER_NAME=worker-production-1
ORALSIGHT_WORKER_CONCURRENCY=2
ORALSIGHT_MAX_CONCURRENT_INFERENCE=2
ORALSIGHT_RATE_LIMIT_PER_CLIENT=30
ORALSIGHT_RATE_LIMIT_GLOBAL=300
ORALSIGHT_RATE_LIMIT_WINDOW_SECONDS=60
